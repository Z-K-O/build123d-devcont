{
  "name": "build123d-devcont",
  "build": {
    "dockerfile": "Dockerfile",
    "cacheFrom": "ghcr.io/Z-K-O/build123d-devcont:latest"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "bernhard-42.ocp-cad-viewer",
        "ms-toolsai.jupyter"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/venv/bin/python"
      }
    }
  },
  "forwardPorts": [3939],
  "remoteUser": "dev",
  "postAttachCommand": "bash .devcontainer/open-template.sh"
}